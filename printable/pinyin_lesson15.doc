{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?15\u35838? - \u25972?\u20307?\u35748?\u35835?\u38899?\u33410? \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 16 \u20010?\u25972?\u20307?\u35748?\u35835?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b zhi chi shi ri\b0\par\pard\fs36\b zi ci si\b0\par\pard\fs36\b yi wu yu\b0\par\pard\fs36\b ye yue yuan\b0\par\pard\fs36\b yin yun ying\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: zhi chi shi ri \u32728?\u33292?\u38899?, zi ci si \u24179?\u33292?\u38899?, yi wu yu \u19981?\u29992?\u25340?, ye yue yuan \u25972?\u20307?\u35760?, yin yun ying \u35201?\u29282?\u35760?\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 zhi\cf7       zhi  zhi  zhi  zhi\cf1\f0\par\pard\fs60\cf1\f1 chi\cf7       chi  chi  chi  chi\cf1\f0\par\pard\fs60\cf1\f1 shi\cf7       shi  shi  shi  shi\cf1\f0\par\pard\fs60\cf1\f1 ri\cf7       ri  ri  ri  ri\cf1\f0\par\pard\fs60\cf1\f1 zi\cf7       zi  zi  zi  zi\cf1\f0\par\pard\fs60\cf1\f1 ci\cf7       ci  ci  ci  ci\cf1\f0\par\pard\fs60\cf1\f1 si\cf7       si  si  si  si\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. \u25972?\u20307?\u35748?\u35835?\u34920?\u26391?\u35835?\u25171?\u21345?\par\pard\sl420\fs28 2. \u20363?\u35789?: zhi\u8594?zh\u299?d\u224?o(\u30693?\u36947?) zh\u464?(\u32440?)\pa