{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?1\u35838? - a o e \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 \u21333?\u38901?\u27597?\u20837?\u38376?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b \u257? \u225? \u462? \u224?\b0\par\pard\fs36\b \u333? \u243? \u466? \u242?\b0\par\pard\fs36\b \u275? \u233? \u283? \u232?\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: \u24352?\u22823?\u22068?\u24052? a a a, \u20844?\u40481?\u25171?\u40483? o o o, \u30333?\u40517?\u20498?\u24433? e e e\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 a\cf7       a  a  a  a\cf1\f0\par\pard\fs60\cf1\f1 o\cf7       o  o  o  o\cf1\f0\par\pard\fs60\cf1\f1 e\cf7       e  e  e  e\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. \u35835? a o e \u21345?\u29255? 3 \u36941?\par\pard\sl420\fs28 2. \u20363?\u35789?: a\u8594?\u257?y\u237?(\u38463?\u23016?) b\u224?ba(\u29240?\u29240?) m\u257?ma(\u22920?\u22920?) d\u224?(\u22823?) t\u257?(\u20182?)\par\pard\sl420\fs28 3. \u20363?\u35789?: o\u8594?w\u333?(\u31389?) w\u466?(\u25105?) b\u333?lu\u243?(\u33760?\u33821?)\par\pard\sl420\fs28 4. \u20363?\u35789?: e\u8594?\u233?(\u40517?) h\u233?(\u27827?) g\u275?ge(\u21733?\u21733?)\par\pard\sl420\fs28 5. \u25551?\u32418? a o e \u21508? 1 \u34892?\par\pard\cb3\cf4\b\fs36 \u36830?\u19968?\u36830?