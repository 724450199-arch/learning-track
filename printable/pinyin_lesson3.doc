{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?3\u35838? - b p m f \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 \u22768?\u27597?\u20837?\u38376?+\u25340?\u35835?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b b+a  b\u257? b\u225? b\u462? b\u224?\b0\par\pard\fs36\b p+a  p\u257? p\u225? p\u462? p\u224?\b0\par\pard\fs36\b m+a  m\u257? m\u225? m\u462? m\u224?\b0\par\pard\fs36\b f+a  f\u257? f\u225? f\u462? f\u224?\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: \u25910?\u21548?\u24191?\u25773? b b b, \u19978?\u23665?\u29228?\u22369? p p p, \u20004?\u20010?\u38376?\u27934? m m m, \u19968?\u26681?\u25296?\u26454? f f f\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 b\cf7       b  b  b  b\cf1\f0\par\pard\fs60\cf1\f1 p\cf7       p  p  p  p\cf1\f0\par\pard\fs60\cf1\f1 m\cf7       m  m  m  m\cf1\f0\par\pard\fs60\cf1\f1 f\cf7       f  f  f  f\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. \u35835? b p m f \u21345?\u29255?\par\pard\sl420\fs28 2. \u20363?\u35789?: b\u8594?b\u257?(\u20843?) b\u237?(\u40763?) b\u224?ba(\u29240?\u29240?) b\u249?(\u24067?)\par\pard\sl420\fs28 3. \u20363?\u35789?: p\u8594?p\u257?(\u36276?) p\u250?tao(\u33889?\u33796?) p\u242?(\u30772?)\par\pard\sl420\fs28 4. \u20363?\u35789?: m\u8594?m\u257?ma(\u22920?\u22920?) m\u464?(\u31859?) m\