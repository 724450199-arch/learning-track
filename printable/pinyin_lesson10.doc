{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?10\u35838? - ai ei ui \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 \u22797?\u38901?\u27597?\u20837?\u38376?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b \u257?i \u225?i \u462?i \u224?i\b0\par\pard\fs36\b \u275?i \u233?i \u283?i \u232?i\b0\par\pard\fs36\b u\u299? u\u237? u\u464? u\u236?\b0\par\pard\fs36\b b+ai  b\u257?i b\u225?i b\u462?i b\u224?i\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: a+i \u22909?\u26379?\u21451? ai ai ai, e+i \u22312?\u19968?\u36215? ei ei ei, u+i \u25163?\u25289?\u25163? ui ui ui\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 ai\cf7       ai  ai  ai  ai\cf1\f0\par\pard\fs60\cf1\f1 ei\cf7       ei  ei  ei  ei\cf1\f0\par\pard\fs60\cf1\f1 ui\cf7       ui  ui  ui  ui\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. ai ei ui \u22235?\u22768?\u26391?\u35835?\par\pard\sl420\fs28 2. \u20363?\u35789?: ai\u8594?b\u225?i(\u30333?) k\u257?i(\u24320?) c\u224?i(\u33756?) \u224?i(\u29233?)\par\pard\sl420\fs28 3. \u20363?\u35789?: ei\u8594?b\u275?i(\u26479?) m\u233?i(\u27809?) f\u275?i(\u39134?) h\u275?i(\u40657?)\par\pard\sl420\fs28 4. \u20363?\u35789?: ui\u8594?hu\u237?(\u22238?) gu\u236?(\u36149?) zu\u464?(\u22068?) shu\u236?(\u30561?)\par\pard\sl420\fs28 5. \u25551?\u32418? ai ei ui \u2