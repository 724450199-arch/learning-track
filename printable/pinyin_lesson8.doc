{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?8\u35838? - z c s y w \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 \u24179?\u33292?\u38899?\u25972?\u20307?\u35748?\u35835?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b z+a  z\u257? z\u225? z\u462? z\u224?\b0\par\pard\fs36\b c+a  c\u257? c\u462? c\u224?\b0\par\pard\fs36\b s+a  s\u257? s\u462? s\u224?\b0\par\pard\fs36\b y\u299? y\u237? y\u464? y\u236?\b0\par\pard\fs36\b w\u363? w\u250? w\u468? w\u249?\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: \u23567?\u23567?\u34453?\u20799? z z z, \u21050?\u29484?\u28385?\u36523? c c c, \u34453?\u20799?\u21520?\u19997? s s s, \u26641?\u26440?\u26238?\u34915? y y y, \u23627?\u39030?\u30456?\u36830? w w w\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 z\cf7       z  z  z  z\cf1\f0\par\pard\fs60\cf1\f1 c\cf7       c  c  c  c\cf1\f0\par\pard\fs60\cf1\f1 s\cf7       s  s  s  s\cf1\f0\par\pard\fs60\cf1\f1 y\cf7       y  y  y  y\cf1\f0\par\pard\fs60\cf1\f1 w\cf7       w  w  w  w\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. 23 \u20010?\u22768?\u27597?\u25353?\u24207?\u26391?\u35835?\par\pard\sl420\fs28 2. \u20363?\u35789?: z\u8594?z\u250?(\u36275?) z\u236?(\u23383?) zu\u242?(\u22352?) z\u466?u(\u36208?)\par\pard\sl420\fs28 3. \u20363?\u35789?: c\u8594?c\u236?(\u21050?) c\u257?(\u25830?) c\u224?i(\u33756?)\par\pard\sl420\fs28 4. \u20363?\u35789?: s\u8594?s\u236?(\u22235?) s\u462?(\u27922?) s\u249?(\u36895?) s\u275?n(\u26862?)\par\pard\sl420\fs28 5. \u20363?\u35789?: y\u8594?y\u299?(\u19968?) y\u468?(\u38632?) y\u250?n(\u20113?) yu\u232?(\u26376?)\par\pard\sl420\fs28 6. \u20363?\u35789?: w\u8594?w\u363?(\u23627?) w\u225?wa(\u23043?\u23043?) w\u466?(\u25105?) w\u468?(\u20116?)\par\pard\sl420\fs28 7. \u40664?\u20889?\u25152?\u26377?\u22768?\u27597?\par\pard\cb3\cf4\b\fs36 \u36830?\u19968?\u36830?\u65306?\u23558?\u25340?\u38899?\u19982?\u23545?\u24212?\u30340?\u27721?\u23383?\u36830?\u32447?\cf1\b0\par{\trowd\cellx3500\cellx7000\intbl\pard\intbl\cf2\b\fs28 \u25340?\u38899?\cell \pard\intbl\cf2\b\fs28 \u27721?\u23383?\cell\row\b0\cf1\pard\intbl\fs28\cf1\f1 z\u250?\cell \pard\intbl\fs28\cf1 \u20113?\cell\row\pard\intbl\fs28\cf1\f1 z\u236?\cell \pard\intbl\fs28\cf1 \u25105?\cell\row\pard\intbl\fs28\cf1\f1 zu\u242?\cell \pard\intbl\fs28\cf1 \u36895?\cell\row\pard\intbl\fs28\cf1\f1 z\u466?u\cell \pard\intbl\fs28\cf1 \u25830?\cell\row\pard\intbl\fs28\cf1\f1 c\u236?\cell \pard\intbl\fs28\cf1 \u23043?\u23043?\cell\row\pard\intbl\fs28\cf1\f1 c\u257?\cell \pard\intbl\fs28\cf1 \u36208?\cell\row\pard\intbl\fs28\cf1\f1 c\u224?i\cell \pard\intbl\fs28\cf1 \u38632?\cell\row\pard\intbl\fs28\cf1\f1 s\u236?\cell \pard\intbl\fs28\cf1 \u23383?\cell\row\pard\intbl\fs28\cf1\f1 s\u462?\cell \pard\intbl\fs28\cf1 \u21050?\cell\row\pard\intbl\fs28\cf1\f1 s\u249?\cell \pard\intbl\fs28\cf1 \u20116?\cell\row\pard\intbl\fs28\cf1\f1 s\u275?n\cell \pard\intbl\fs28\cf1 \u19968?\cell\row\pard\intbl\fs28\cf1\f1 y\u299?\cell \pard\intbl\fs28\cf1 \u36275?\cell\row\pard\intbl\fs28\cf1\f1 y\u468?\cell \pard\intbl\fs28\cf1 \u27922?\cell\row\pard\intbl\fs28\cf1\f1 y\u250?n\cell \pard\intbl\fs28\cf1 \u26376?\cell\row\pard\intbl\fs28\cf1\f1 yu\u232?\cell \pard\intbl\fs28\cf1 \u22352?\cell\row\pard\intbl\fs28\cf1\f1 w\u363?\cell \pard\intbl\fs28\cf1 \u23627?\cell\row\pard\int