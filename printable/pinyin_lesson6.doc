{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?6\u35838? - j q x \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 +\u252?\u30465?\u20889?\u35268?\u21017?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b j+i  j\u299? j\u237? j\u464? j\u236?\b0\par\pard\fs36\b q+i  q\u299? q\u237? q\u464? q\u236?\b0\par\pard\fs36\b x+i  x\u299? x\u237? x\u464? x\u236?\b0\par\pard\fs36\b j+\u252?  j\u363? j\u250? j\u468? j\u249?\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: \u27597?\u40481?\u25417?\u34411? j j j, \u19971?\u24425?\u27668?\u29699? q q q, \u19968?\u20010?\u22823?\u21449? x x x\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 j\cf7       j  j  j  j\cf1\f0\par\pard\fs60\cf1\f1 q\cf7       q  q  q  q\cf1\f0\par\pard\fs60\cf1\f1 x\cf7       x  x  x  x\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. \u35835? j q x \u21345?\u29255?\par\pard\sl420\fs28 2. \u20363?\u35789?: j\u8594?j\u299?(\u40481?) j\u250?(\u33738?) ji\u257?(\u23478?) ji\u468?(\u37202?)\par\pard\sl420\fs28 3. \u20363?\u35789?: q\u8594?q\u237?(\u26071?) q\u249?(\u21435?) qi\u250?(\u29699?) q\u299?(\u19971?)\par\pard\sl420\fs28 4. \u20363?\u35789?: x\u8594?x\u299?(\u35199?) xi\u224?(\u19979?) x\u464?(\u27927?) xu\u233?(\u23398?)\par\pard\sl420\fs28 5. \u25551?\u32418? j q x \u21508? 1 \u34892?\par\pard