{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?11\u35838? - ao ou iu \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 \u22797?\u38901?\u27597?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b \u257?o \u225?o \u462?o \u224?o\b0\par\pard\fs36\b \u333?u \u243?u \u466?u \u242?u\b0\par\pard\fs36\b i\u363? i\u250? i\u468? i\u249?\b0\par\pard\fs36\b d+ao  d\u257?o d\u462?o d\u224?o\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: a+o \u22823?\u22768?\u21898? ao ao ao, o+u \u27431?\u27954?\u36208? ou ou ou, i+u \u37038?\u36882?\u20449? iu iu iu\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 ao\cf7       ao  ao  ao  ao\cf1\f0\par\pard\fs60\cf1\f1 ou\cf7       ou  ou  ou  ou\cf1\f0\par\pard\fs60\cf1\f1 iu\cf7       iu  iu  iu  iu\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. ao ou iu \u22235?\u22768?\u26391?\u35835?\par\pard\sl420\fs28 2. \u20363?\u35789?: ao\u8594?g\u257?o(\u39640?) m\u257?o(\u29483?) p\u462?o(\u36305?) d\u257?o(\u20992?)\par\pard\sl420\fs28 3. \u20363?\u35789?: ou\u8594?g\u466?u(\u29399?) t\u243?u(\u22836?) z\u466?u(\u36208?)\par\pard\sl420\fs28 4. \u20363?\u35789?: iu\u8594?li\u249?(\u20845?) qi\u250?(\u29699?) ni\u250?(\u29275?) ji\u468?(\u37202?)\par\pard\sl420\fs28 5. \u25551?\u32418? ao ou iu \u21508? 1 \u34892?\par\pard\cb3\cf4\b\fs36 \u36830?\u19968?\u36830?\u65306?\u23558?\u25340?\u38899?\u19982?\u23545?\u24212?\u30340?\u27721?\u23383?\u36830?\u32447?\cf1\b0\par{\trowd\cellx3500\cellx7000\intbl\pard\intbl\cf2\b\fs28 \u25340?\u38899?\cell \pard\intbl\cf2\b\fs28 \u27721?\u23383?\cell\row\b0\cf1\pard\intbl\fs28\cf1\f1 g\u257?o\cell \pard\intbl\fs28\cf1 \u29399?\cell\row\pard\intbl\fs28\cf1\f1 m\u257?o\cell \pard\intbl\fs28\cf1 \u22836?\cell\row\pard\intbl\fs28\cf1\f1 p\u462?o\cell \pard\intbl\fs28\cf1 \u29275?\cell\row\pard\intbl\fs28\cf1\f1 d\u257?o\cell \pard\intbl\fs28\cf1 \u29483?\cell\row\pard\intbl\fs28\cf1\f1 g\u466?u\cell \pard\intbl\fs28\cf1 \u20992?\cell\row\pard\intbl\fs28\cf1\f1 t\u243?u\cell \pard\intbl\fs28\cf1 \u29699?\cell\row\pard\intbl\fs28\cf1\f1 z\u466?u\cell \pard\intbl\fs28\cf1 \u36305?\cell\row\pard\intbl\fs28\cf1\f1 li\u249?\cell \pard\intbl\fs28\cf1 \u36208?\cell\row\pard\intbl\fs28\cf1\f1 qi\u250?\cell \pard\intbl\fs28\cf1 \u20845?\cell\row\pard\intbl\fs28\cf1\f1 ni\u250?\cell \pard\intbl\fs28\cf1 \u39640?\cell\row\pard\intbl\fs28\cf1\f1 ji\u468?\cell \pard\intbl\fs28\cf1 \u37202?\cell\row}\pard\fs20 \u29983?\u25104?\u26085?\u26399?: 2026-07-12\par}