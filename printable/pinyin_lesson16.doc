{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?16\u35838? - \u24635?\u22797?\u20064?+\u38383?\u20851? \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 \u32467?\u35838?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b 23 \u20010?\u22768?\u27597?\b0\par\pard\fs36\b 24 \u20010?\u38901?\u27597?\b0\par\pard\fs36\b 16 \u20010?\u25972?\u20307?\u35748?\u35835?\u38899?\u33410?\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: \u25340?\u38899?\u29579?\u22269?\u30495?\u26377?\u36259?, \u22768?\u27597?\u38901?\u27597?\u22312?\u19968?\u36215?, \u25972?\u20307?\u35748?\u35835?\u35201?\u35760?\u20303?, \u25105?\u33021?\u35835?\u21448?\u33021?\u20889?\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 \u21517?\u23383?\u25340?\u38899?: \cf7       \u21517?\u23383?\u25340?\u38899?:   \u21517?\u23383?\u25340?\u38899?:   \u21517?\u23383?\u25340?\u38899?:   \u21517?\u23383?\u25340?\u38899?: \cf1\f0\par\pard\fs60\cf1\f1 ____\cf7       ____  ____  ____  ____\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. \u40664?\u20889?\u20840?\u37096?\u22768?\u27597?+\u38901?\u27597?\par\pard\sl420\fs28 2. \u25340?\u35835?: sh\u257?n shu\u464?(\u23665?\u27700?) hu\u257? du\u333?(\u33457?\u26421?) t\u225?i y\u225?ng(\u22826?\u38451?) xi\u462?o g\u466?u(\u23567?\u29399?) g\u333?ng j\u299?(\u20844?\u