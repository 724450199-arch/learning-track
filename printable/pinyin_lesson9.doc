{\rtf1\ansi\deff0{\fonttbl{\f0\fnil\fcharset134 SimSun;}{\f1\fnil\fcharset0 Century Gothic;}}{\colortbl;\red0\green0\blue0;\red229\green57\blue53;\red255\green243\blue224;\red230\green81\blue0;\red191\green54\blue12;\red232\green245\blue253;\red200\green205\blue215;\red0\green51\blue153;\red255\green255\blue255}\paperw11900\paperh16840\margl1134\margr1134\margt567\margb567\pard\f0\fs28\pard\cf2\b\fs44 \u31532?9\u35838? - \u22768?\u27597?\u24635?\u22797?\u20064? \u25340?\u38899?\u32451?\u20064?\cf1\b0\par\pard\cf8\fs24 \u38454?\u27573?\u23567?\u27979?  \u29983?\u25104?\u26085?\u26399?: 2026-07-12\cf1\par\pard\cb3\cf8\b\fs36 \u26391?\u35835?\u32451?\u20064? - \u22823?\u22768?\u35835?3\u36941?\cf1\b0\par\pard\fs36\b b p m f d t n l\b0\par\pard\fs36\b g k h j q x\b0\par\pard\fs36\b zh ch sh r z c s y w\b0\par\pard\cf5\b\fs28 \u39034?\u21475?\u28316?: \u22768?\u27597?\u19968?\u20849? 23 \u20010?, b p m f \u24320?\u22836?\u26469?, d t n l \u36319?\u21518?\u38754?, g k h j q x \u25490?, zh ch sh r z c s, y w \u20004?\u20301?\u26368?\u21518?\u26469?\cf1\b0\par\pard\cb3\cf2\b\fs36 \u20070?\u20889?\u32451?\u20064? - \u25551?\u32418?\cf1\b0\par\pard\fs24 (\u22312?\u27178?\u32447?\u19978?\u25551?\u32418?, \u27880?\u24847?\u21344?\u20013?\u26684?\u20301?\u32622?)\par\pard\fs60\cf1\f1 b-d\cf7       b-d  b-d  b-d  b-d\cf1\f0\par\pard\fs60\cf1\f1 p-q\cf7       p-q  p-q  p-q  p-q\cf1\f0\par\pard\fs60\cf1\f1 zh-ch-sh\cf7       zh-ch-sh  zh-ch-sh  zh-ch-sh  zh-ch-sh\cf1\f0\par\pard\cb3\cf4\b\fs36 \u35838?\u21518?\u32451?\u20064?\cf1\b0\par\pard\sl420\fs28 1. \u22768?\u27597?\u34920?\u26391?\u35835?\u25171?\u21345?\par\pard\sl420\fs28 2. \u20363?\u35789?\u23545?\u27604?: b-d\u8594?b\u257?(\u20843?) d\u257?(\u25645?) b\u237?(\u40763?) d\u237?(\u31515?)\par\pard\sl420\fs28 3. \u20363?\u35789?\u23545?\u27604?: p-q\u8594?p\u257?(\u36276?) q\u299?(\u19971?) p\u250?(\u33889?) q\u250?(\u28192?)\par\pard\sl420\fs28 4. \u20363?\u35789?\u23545?\u27604?: zh-z\u8594?zh\u464?(\u32440?) z\u464?(\u32